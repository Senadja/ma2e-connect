# Reverse proxy HTTP simple pour l'API MA2E.
# Le serveur est derrière une passerelle (openresty) qui ne nous laisse pas
# joindre 80/443 : c'est CETTE passerelle qui termine le TLS et nous proxifie.
# Caddy ne fait donc PAS de HTTPS ici — il écoute en HTTP sur :80 (publié en 3182).

:80 {
	encode gzip

	# Tout (/api/* et /documents/uploads/*) est servi par le backend Node.
	reverse_proxy backend:3000

	header {
		# Durcissement de base
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
