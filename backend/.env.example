# Exemple de configuration backend — copier vers .env et adapter.
DATABASE_URL="postgresql://ma2e_admin:ma2e_password@localhost:5432/ma2edb?schema=public"
PORT=3000

# Auth — CHANGER JWT_SECRET en production (chaîne longue et aléatoire).
JWT_SECRET="change-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Double authentification par code e-mail à la connexion au back-office.
# Activée par défaut. MFA_ENABLED="false" est un COUPE-CIRCUIT D'URGENCE, à n'utiliser
# que si l'envoi d'e-mail est en panne ET que les codes de secours sont perdus.
MFA_ENABLED="true"

# Rate limiting (anti brute-force / anti-spam). Défauts = comportement normal.
# Audit de charge (serveur de TEST) : RATE_LIMIT_DISABLED="true" coupe tous les limiteurs,
# à remettre à "false" après. Ou relevez un plafond précis. Redémarrage du backend requis.
RATE_LIMIT_DISABLED="false"
# RATE_LIMIT_WINDOW_MIN="15"
# RATE_LIMIT_LOGIN_MAX="10"
# RATE_LIMIT_VERIFY_MAX="30"
# RATE_LIMIT_PUBLIC_WRITE_MAX="20"

# CORS — origine(s) du front, séparées par des virgules.
CORS_ORIGIN="http://localhost:5174,http://localhost:8080"

# Dossier d'upload (laisser vide en local ; en Docker : /app/uploads)
UPLOAD_DIR=""

# SMTP (notifications e-mail des demandes) — vide = mode log (pas d'envoi réel).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MA2E <no-reply@ma2e.ci>"
MAIL_TO_APPLICATIONS="contact@ma2e.ci"
