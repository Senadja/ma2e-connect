# Exemple de configuration backend — copier vers .env et adapter.
DATABASE_URL="postgresql://ma2e_admin:ma2e_password@localhost:5432/ma2edb?schema=public"
PORT=3000

# Auth — CHANGER JWT_SECRET en production (chaîne longue et aléatoire).
JWT_SECRET="change-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# CORS — origine(s) du front, séparées par des virgules.
CORS_ORIGIN="http://localhost:5174,http://localhost:8080"

# Dossier d'upload (laisser vide en local ; en Docker : /app/uploads)
UPLOAD_DIR=""

# SMTP (notifications e-mail des demandes) — vide = mode log (pas d'envoi réel).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MA2E <no-reply@ma2e.ci>"
MAIL_TO_APPLICATIONS="contact@ma2e.ci"
