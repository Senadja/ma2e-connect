# Modèle d'environnement de PRODUCTION (serveur).
# Sur le serveur : copier en .env.prod et remplir. NE JAMAIS committer .env.prod.
#   cp .env.prod.example .env.prod && nano .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Mot de passe PostgreSQL (fort, aléatoire)
DB_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Secret JWT (long et aléatoire, ex: openssl rand -hex 32)
JWT_SECRET=remplacer-par-une-chaine-aleatoire-tres-longue

# Double authentification à la connexion au back-office (code à 6 chiffres par e-mail).
# Laisser vide ou "true". Passer à "false" UNIQUEMENT en cas d'urgence : e-mail en panne
# et codes de secours perdus. Nécessite un redémarrage du backend.
MFA_ENABLED=true

# Coupe-circuits TEMPORAIRES de test (audit de charge / re-test cyber). Défaut = false
# (protection normale). À REMETTRE à false après la campagne. Redémarrage du backend requis.
#  - RATE_LIMIT_DISABLED=true coupe TOUS les limiteurs (login, 2FA, formulaires publics),
#    sinon une seule IP de test est bloquée en quelques secondes. ⚠ Prod sans limite =
#    brute-force ouvert sur le login → n'activer que le temps du test.
#  - APPLICATION_NOTIFY_DISABLED=true coupe l'e-mail envoyé à chaque nouvelle demande.
RATE_LIMIT_DISABLED=false
APPLICATION_NOTIFY_DISABLED=false

# Origine du front autorisée (CORS)
CORS_ORIGIN=https://ma2e-connect.vercel.app

# Domaine de l'API pour Caddy / Let's Encrypt.
# Sans domaine perso : on utilise sslip.io qui résout l'IP publique automatiquement.
API_DOMAIN=188-165-77-237.sslip.io

# Lancer le seed initial au premier démarrage (mettre false ensuite)
SEED_ON_START=true

# SMTP (optionnel — laisser vide si non utilisé ; configurable aussi via le back-office)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MA2E <no-reply@ma2e.ci>
MAIL_TO_APPLICATIONS=contact@ma2e.ci
